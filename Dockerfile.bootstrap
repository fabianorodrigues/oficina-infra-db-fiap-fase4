ARG SQL_TOOLS_IMAGE
FROM ${SQL_TOOLS_IMAGE}

WORKDIR /opt/bootstrap
COPY scripts/run-database-bootstrap.sh /opt/bootstrap/run-database-bootstrap.sh
COPY scripts/provision-admin-user.sh /opt/bootstrap/provision-admin-user.sh
COPY scripts/validate-database-isolation.sh /opt/bootstrap/validate-database-isolation.sh
COPY scripts/bootstrap-databases.sql /opt/bootstrap/scripts/bootstrap-databases.sql
COPY scripts/validate-databases.sql /opt/bootstrap/scripts/validate-databases.sql
COPY scripts/provision-admin-user.sql /opt/bootstrap/scripts/provision-admin-user.sql

RUN chmod +x /opt/bootstrap/run-database-bootstrap.sh \
             /opt/bootstrap/provision-admin-user.sh \
             /opt/bootstrap/validate-database-isolation.sh

# Entrypoint padrao: bootstrap estrutural dos bancos.
# Os jobs provision-admin e db-isolation sobrescrevem o command para
# /opt/bootstrap/provision-admin-user.sh e /opt/bootstrap/validate-database-isolation.sh.
ENTRYPOINT ["/opt/bootstrap/run-database-bootstrap.sh"]
